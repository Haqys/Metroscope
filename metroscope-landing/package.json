{
  "name": "metroscope-landing",
  "version": "0.1.0",
  "private": true,
  "description": "Metroscope public marketing site. SSG/ISR, CMS-driven.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "next dev --turbopack -p 3004",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "guard": "node scripts/guard-secrets.mjs && node scripts/guard-suspense.mjs",
    "verify": "npm run guard && npm run typecheck && npm run lint && npm run format:check"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@sentry/nextjs": "^10.69.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "@tanstack/react-query": "^5.90.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.544.0",
    "next": "15.5.25",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "react-hook-form": "^7.63.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
