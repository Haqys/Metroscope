# Landing site, public marketing. No session, no privileged secrets.

# ── API service (build/ISR time only, never at request time) ──
API_URL=http://localhost:3000/api

# ── ISR purge hook, called by the API after a CMS publish ──
# Must match REVALIDATE_SECRET in metroscope-api. Generate: openssl rand -hex 24
REVALIDATE_SECRET=change-me-at-least-16-chars

# ── Canonical URL for metadata, sitemap and JSON-LD ──
NEXT_PUBLIC_SITE_URL=http://localhost:3004

# ── Auth ──
# /login lives on this app. One door for every role (doc 03 FR-AC-3). Sign-in
# happens server-side so tokens land in HttpOnly cookies, never in JS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Shared cookie domain for cross-app SSO.
#
# LEAVE BLANK IN LOCAL DEVELOPMENT. Cookies are scoped by host and path, NOT
# by port, so a host-only cookie set by the landing app on localhost:3004 is
# already sent to localhost:3001/3002/3003. No hosts file, no *.localhost.
#
# Setting a Domain the page is not under (e.g. .metroscope.test while browsing
# localhost) makes the browser DROP the cookie silently, login appears to
# succeed and the session never sticks.
#
# In production this is .metroscope.id.
COOKIE_DOMAIN=

# Where each role lands after login.
PORTAL_URL=http://localhost:3001
INTERNAL_URL=http://localhost:3002
MENTOR_URL=http://localhost:3003

# Error reporting (optional). Absent = SDK never initialises.
# A DSN is a write-only ingest key, not a secret.
NEXT_PUBLIC_SENTRY_DSN=

# Server-side error reporting. The instrumentation reads SENTRY_DSN first and
# falls back to NEXT_PUBLIC_SENTRY_DSN, so set this one to keep the DSN out of
# the browser bundle; set the NEXT_PUBLIC_ one only if client-side errors are
# wanted too. Either may be absent, the SDK then never initialises.
SENTRY_DSN=

# ═══════════════════════════════════════════════════════════════════════════
#  Standalone deploy: this site WITHOUT the API behind it
# ═══════════════════════════════════════════════════════════════════════════
#
# Set to "true" to deploy the marketing site on its own, before
# api.metroscope.id exists. In that mode:
#
#   · programmes, mentors, articles, FAQ, testimonials and competitions are
#     served from lib/mock/content.ts, which is SAMPLE content, not the
#     business's own (prices and testimonials included);
#   · /login is removed, along with the "Masuk" and "Portal Siswa" links;
#   · the registration and contact forms show a notice instead of a submit
#     button, so nothing can be silently lost;
#   · robots.txt disallows everything and every page carries noindex, so a
#     review deployment cannot be indexed.
#
# With this on, API_URL, REVALIDATE_SECRET and the two SUPABASE_* values are
# not required. Turning it off is the whole of "go live": the loaders start
# calling the API, login returns, and the forms post again.
NEXT_PUBLIC_STANDALONE=false

# ── Contact details: real ones only, all optional ──
#
# Anything left unset is NOT RENDERED. No placeholder is ever shown, because
# the previous placeholder (halo@metroscope.id) sat on an unregistered domain
# and was the address the registration form offered when a submission failed.
#
# These are also the only channels the standalone forms can offer, so with
# none set, a visitor who wants to reach you has no way to.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_CONTACT_HOURS=
NEXT_PUBLIC_INSTAGRAM_URL=
