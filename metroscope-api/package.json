{
  "name": "metroscope-api",
  "version": "0.1.0",
  "private": true,
  "description": "Metroscope API service, headless Next.js Route Handlers. All business logic.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "guard": "node scripts/guard-secrets.mjs && node scripts/guard-routes.mjs && node scripts/guard-suspense.mjs && node scripts/guard-sql.mjs",
    "verify": "npm run guard && npm run typecheck && npm run lint && npm run format:check",
    "db:seed": "node scripts/seed.mjs",
    "db:policies": "node scripts/apply-policies.mjs",
    "test:rls": "node scripts/test-rls.mjs",
    "test:leads": "node scripts/test-leads.mjs",
    "test:notifications": "node scripts/test-notifications.mjs",
    "verify:email": "node scripts/verify-email.mjs",
    "db:seed:demo": "node scripts/seed-demo.mjs",
    "db:seed:production": "node scripts/seed-production.mjs",
    "db:seed:accounts": "node scripts/seed-accounts.mjs",
    "test:conversion": "node scripts/test-conversion.mjs",
    "test:payments": "node scripts/test-payments.mjs",
    "test:billing-run": "node scripts/test-billing-run.mjs",
    "test:inbox": "node scripts/test-inbox.mjs",
    "test:authz": "node scripts/test-authz.mjs",
    "test:cms": "node scripts/test-cms.mjs",
    "test:media": "node scripts/test-media.mjs",
    "readiness": "node scripts/readiness.mjs",
    "test:articles": "node scripts/test-articles.mjs",
    "test:public-articles": "node scripts/test-public-articles.mjs",
    "test:status": "node scripts/test-status-codes.mjs",
    "test:seo": "node scripts/test-seo.mjs",
    "test:scheduling": "node scripts/test-scheduling.mjs",
    "test:reschedule": "node scripts/test-reschedule.mjs",
    "test:materials": "node scripts/test-materials.mjs",
    "test:competitions": "node scripts/test-competitions.mjs",
    "test:assessments": "node scripts/test-assessments.mjs",
    "test:progress": "node scripts/test-progress.mjs",
    "test:achievements": "node scripts/test-achievements.mjs",
    "test:grants": "node scripts/test-grants.mjs",
    "test:security-matrix": "node scripts/test-security-matrix.mjs",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "verify:integrity": "node scripts/verify-integrity.mjs",
    "verify:monitoring": "node --experimental-strip-types scripts/verify-monitoring.mjs",
    "grants:inventory": "node scripts/grant-inventory.mjs",
    "drill:restore": "node scripts/restore-drill.mjs",
    "test:calendar": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/test-calendar.mjs",
    "verify:calendar": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/verify-calendar.mjs",
    "test:me": "node scripts/test-me.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.69.0",
    "@supabase/supabase-js": "^2.58.0",
    "@upstash/qstash": "^2.8.2",
    "@upstash/ratelimit": "^2.0.6",
    "@upstash/redis": "^1.35.4",
    "drizzle-orm": "^0.44.5",
    "jose": "^6.1.0",
    "next": "15.5.25",
    "postgres": "^3.4.7",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.36.0",
    "eslint-config-next": "15.5.25",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "^5.9.2"
  }
}
