{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/jobs/billing-draft",
      "schedule": "0 19 24 * *"
    },
    {
      "path": "/api/jobs/invoice-overdue",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/jobs/invoice-reminder",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/jobs/outbox-dispatch",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/jobs/backup-verify",
      "schedule": "0 20 * * 0"
    },
    {
      "path": "/api/jobs/content-publish",
      "schedule": "*/5 * * * *"
    }
  ]
}
